# Required for every environment. Use an HTTPS public URL in production.
APP_ORIGIN=http://localhost:3000
PORT=3000
TRUST_PROXY=false
DATABASE_PATH=./data/xiuxian.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
CARD_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Independent web admin login. Used only to bootstrap the first account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-12-character-password

# Telegram buyer Mini App login. Can also be set from Admin > Settings.
TELEGRAM_BOT_TOKEN=
SUPPORT_URL=https://t.me/your_support_bot

# DujiaoPay can be bootstrapped here or saved (encrypted) in Admin > Payment Channels.
# Leave all three secrets empty to start with the channel disabled and configure it in the admin UI.
PAYMENT_PROVIDER=dujiaopay
DUJIAOPAY_BASE_URL=https://www.dujiaopay.com
DUJIAOPAY_KEY_ID=
DUJIAOPAY_SECRET=
DUJIAOPAY_WEBHOOK_SECRET=
DUJIAOPAY_CHAIN=tron
DUJIAOPAY_TOKEN_ID=tron-usdt
ORDER_PAYMENT_TTL_MINUTES=15
