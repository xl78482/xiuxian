# Required for every environment. Use an HTTPS public URL in production.
APP_ORIGIN=http://localhost:3000
PORT=3000
TRUST_PROXY=false
DATABASE_PATH=./data/xiuxian.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
CARD_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Telegram production login and buyer support entry
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=123456789
SUPPORT_URL=https://t.me/your_support_bot

# DujiaoPay production payment
PAYMENT_PROVIDER=dujiaopay
DUJIAOPAY_BASE_URL=https://www.dujiaopay.com
DUJIAOPAY_KEY_ID=
DUJIAOPAY_SECRET=
DUJIAOPAY_WEBHOOK_SECRET=
DUJIAOPAY_CHAIN=tron
DUJIAOPAY_TOKEN_ID=tron-usdt

# Development only: set PAYMENT_PROVIDER=mock; never use it in production.
